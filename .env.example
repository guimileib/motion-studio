# Copie para .env e preencha. O .env está no .gitignore: nunca faça commit dele.

# ElevenLabs (narração e transcrição) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=scribe_v2

# VoiceStudio (narração local, alternativa à ElevenLabs) — https://github.com/debpalash/VoiceStudio
VOICESTUDIO_URL=http://127.0.0.1:3900
# Motor: omnivoice é só uso NÃO comercial; para anúncio use voxcpm2 (GPU) ou moss-tts-nano (CPU)
VOICESTUDIO_MODEL=moss-tts-nano
# Nome ou id do perfil de voz criado no app (clone de um locutor pt-BR com autorização)
VOICESTUDIO_VOICE=
# Só quando o VoiceStudio roda em outra máquina (use HTTPS)
VOICESTUDIO_API_KEY=

# Bancos de mídia
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# Nome do app registrado no Unsplash (vai no utm_source dos créditos)
UNSPLASH_APP_NAME=motion-studio
